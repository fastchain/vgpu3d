+static void
+vn_vgpu_trace(const char *fmt, ...)
+{
+   char buf[1024];
+   va_list ap;
+   va_start(ap, fmt);
+   int n = snprintf(buf, 40, "%lu %lu ", GetTickCount(), GetCurrentThreadId());
+   vsnprintf(buf + n, sizeof(buf) - n - 2, fmt, ap);
+   va_end(ap);
+   strcat(buf, "\n");
+   if (vn_vgpu_trace_file) {
+      fputs(buf, vn_vgpu_trace_file); /* one fputs per line: the CRT stream lock keeps lines whole */
+      fflush(vn_vgpu_trace_file);
+   } else {
+      OutputDebugStringA(buf);
+   }
