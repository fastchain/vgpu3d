+bool cvk_command::sync_buffer_mirrors(bool before) {
+    std::vector<cvk_buffer*> buffers;
+    const auto mems = memory_objects();
+    for (size_t i = 0; i < mems.size(); i++) {
+        cvk_mem* mem = mems[i];
+        if (mem != nullptr && mem->is_image_type()) {
+            // a CL_MEM_OBJECT_IMAGE1D_BUFFER reads and writes its buffer
+            mem = static_cast<cvk_image*>(mem)->buffer();
+        }
+        if (mem == nullptr || !mem->is_buffer_type()) {
+            continue;
+        }
+        auto* root = static_cast<cvk_buffer*>(mem)->mirror_root();
+        if (!root->has_device_mirror()) {
+            continue;
+        }
+        // copies read their first object and write the last one
+        if (!before && !is_gpu_command() &&
+            (m_type == CL_COMMAND_COPY_BUFFER ||
+             m_type == CL_COMMAND_COPY_BUFFER_RECT) &&
+            i + 1 < mems.size()) {
+            continue;
+        }
+        if (std::find(buffers.begin(), buffers.end(), root) == buffers.end()) {
+            buffers.push_back(root);
+        }
+    }
+    if (buffers.empty()) {
+        return true;
+    }
+
+    if (is_gpu_command()) {
+        for (auto* buffer : buffers) {
+            if (before) {
+                if (!buffer->sync_mirror_to_device(m_queue)) {
+                    return false;
+                }
+            } else {
+                buffer->mark_mirror_device_written();
+            }
+        }
+        return true;
+    }
+
+    bool host_writes = false;
+    switch (m_type) {
+    case CL_COMMAND_WRITE_BUFFER:
+    case CL_COMMAND_WRITE_BUFFER_RECT:
+    case CL_COMMAND_FILL_BUFFER:
+    case CL_COMMAND_COPY_BUFFER:
+    case CL_COMMAND_COPY_BUFFER_RECT:
+    case CL_COMMAND_UNMAP_MEM_OBJECT:
+    case CL_COMMAND_WRITE_IMAGE:
+    case CL_COMMAND_FILL_IMAGE:
+        host_writes = true;
+        break;
+    default:
+        break;
+    }
+    for (auto* buffer : buffers) {
+        if (before) {
+            if (!buffer->sync_mirror_to_host(m_queue)) {
+                return false;
+            }
+        } else if (host_writes) {
+            buffer->mark_mirror_host_written();
+        }
+    }
+    return true;
+}
