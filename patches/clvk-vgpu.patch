+// SM counts of recent NVIDIA GPUs by marketing name (more specific names first). Vulkan has no
+// portable SM count and VK_NV_shader_sm_builtins does not reach the guest through Venus, so the
+// name -- which Venus embeds as "Virtio-GPU Venus (NVIDIA GeForce RTX 4090)" -- is used.
+static uint32_t nvidia_sm_count(const char* name) {
+    static const struct {
+        const char* model;
+        uint32_t sms;
+    } table[] = {
+        {"RTX 5090", 170},       {"RTX 5080", 84},        {"RTX 5070 Ti", 70},
+        {"RTX 5070", 48},        {"RTX 5060 Ti", 36},     {"RTX 5060", 30},
+        {"RTX 4090", 128},       {"RTX 4080 SUPER", 80},  {"RTX 4080", 76},
+        {"RTX 4070 Ti SUPER", 66}, {"RTX 4070 Ti", 60},   {"RTX 4070 SUPER", 56},
+        {"RTX 4070", 46},        {"RTX 4060 Ti", 34},     {"RTX 4060", 24},
+        {"RTX 3090 Ti", 84},     {"RTX 3090", 82},        {"RTX 3080 Ti", 80},
+        {"RTX 3080", 68},        {"RTX 3070 Ti", 48},     {"RTX 3070", 46},
+        {"RTX 3060 Ti", 38},     {"RTX 3060", 28},        {"RTX 3050", 20},
+        {"RTX 2080 Ti", 68},     {"RTX 2080 SUPER", 48},  {"RTX 2080", 46},
+        {"RTX 2070 SUPER", 40},  {"RTX 2070", 36},        {"RTX 2060 SUPER", 34},
+        {"RTX 2060", 30},
+    };
+    std::string upper(name);
+    for (auto& c : upper) {
+        c = toupper(static_cast<unsigned char>(c));
+    }
+    for (auto& entry : table) {
+        std::string model(entry.model);
+        for (auto& c : model) {
+            c = toupper(static_cast<unsigned char>(c));
+        }
+        auto pos = upper.find(model);
+        // "RTX 4070" must not match "RTX 4070 Ti": the next character ends the model name
+        if (pos != std::string::npos) {
+            char next = upper[pos + model.size()];
+            if (next == '\0' || next == ')' ||
+                (next == ' ' && upper.compare(pos + model.size(), 3, " TI") != 0 &&
+                 upper.compare(pos + model.size(), 6, " SUPER") != 0)) {
+                return entry.sms;
+            }
+        }
+    }
+    return 32; // unknown discrete NVIDIA GPU: closer than 1 for work sizing
+}
