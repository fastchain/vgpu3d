+bool cvk_buffer::enable_device_mirror() {
+    if (!config.buffer_device_mirror() || m_parent != nullptr ||
+        has_flags(CL_MEM_USE_HOST_PTR)) {
+        return false;
+    }
+    auto device = m_context->device();
+    auto vkdev = device->vulkan_device();
+    const VkBufferCreateInfo createInfo = {
+        VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO, nullptr, 0, m_size,
+        prepare_usage_flags(), VK_SHARING_MODE_EXCLUSIVE, 0, nullptr};
+    VkBuffer buffer;
+    if (vkCreateBuffer(vkdev, &createInfo, nullptr, &buffer) != VK_SUCCESS) {
+        return false;
+    }
+    VkMemoryRequirements memreqs;
+    vkGetBufferMemoryRequirements(vkdev, buffer, &memreqs);
+    // typed: an int flags expression would bind the (count, list) overload
+    const VkMemoryPropertyFlags required = VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT;
+    const VkMemoryPropertyFlags avoid = VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT;
+    uint32_t type = device->memory_type_index_for_resource(
+        memreqs.memoryTypeBits, required, avoid);
+    if (type == VK_MAX_MEMORY_TYPES) {
+        vkDestroyBuffer(vkdev, buffer, nullptr);
+        return false;
+    }
+    auto memory = std::make_unique<cvk_memory_allocation>(
+        vkdev, memreqs.size, type, true, false);
+    if (memory->allocate(device->uses_physical_addressing()) != VK_SUCCESS ||
+        vkBindBufferMemory(vkdev, buffer, memory->vulkan_memory(), 0) !=
+            VK_SUCCESS) {
+        vkDestroyBuffer(vkdev, buffer, nullptr);
+        return false;
+    }
+    m_mirror_buffer = buffer;
+    m_mirror_memory = std::move(memory);
+    m_mirror_state = has_flags(CL_MEM_COPY_HOST_PTR) ? mirror_state::host_newer
+                                                     : mirror_state::in_sync;
+    cvk_debug_fn("buffer %p: device mirror of %zu bytes (memory type %u)", this,
+                 m_size, type);
+    return true;
+}
+
+bool cvk_buffer::mirror_copy(cvk_command_queue* queue, bool to_device) {
+    cvk_command_buffer cmd(queue);
+    if (!cmd.begin()) {
+        return false;
+    }
+    {
+        cvk_command_pool_lock_holder lock(queue);
+        const VkMemoryBarrier before = {
+            VK_STRUCTURE_TYPE_MEMORY_BARRIER, nullptr,
+            VK_ACCESS_MEMORY_WRITE_BIT | VK_ACCESS_HOST_WRITE_BIT,
+            VK_ACCESS_TRANSFER_READ_BIT | VK_ACCESS_TRANSFER_WRITE_BIT};
+        vkCmdPipelineBarrier(cmd,
+                             VK_PIPELINE_STAGE_ALL_COMMANDS_BIT |
+                                 VK_PIPELINE_STAGE_HOST_BIT,
+                             VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 1, &before, 0,
+                             nullptr, 0, nullptr);
+        const VkBufferCopy region = {0, 0, m_size};
+        vkCmdCopyBuffer(cmd, to_device ? m_buffer : m_mirror_buffer,
+                        to_device ? m_mirror_buffer : m_buffer, 1, &region);
+        const VkMemoryBarrier after = {
+            VK_STRUCTURE_TYPE_MEMORY_BARRIER, nullptr,
+            VK_ACCESS_TRANSFER_WRITE_BIT,
+            VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT |
+                VK_ACCESS_HOST_READ_BIT};
+        vkCmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                             VK_PIPELINE_STAGE_ALL_COMMANDS_BIT |
+                                 VK_PIPELINE_STAGE_HOST_BIT,
+                             0, 1, &after, 0, nullptr, 0, nullptr);
+        if (!cmd.end()) {
+            return false;
+        }
+    }
+    return cmd.submit_and_wait();
+}
+
+bool cvk_buffer::sync_mirror_to_device(cvk_command_queue* queue) {
+    std::lock_guard<std::mutex> lock(m_mirror_lock);
+    if (m_mirror_state != mirror_state::host_newer) {
+        return true;
+    }
+    m_memory->flush(0, m_size);
+    if (!mirror_copy(queue, true)) {
+        return false;
+    }
+    m_mirror_state = mirror_state::in_sync;
+    return true;
+}
+
+bool cvk_buffer::sync_mirror_to_host(cvk_command_queue* queue) {
+    std::lock_guard<std::mutex> lock(m_mirror_lock);
+    if (m_mirror_state != mirror_state::device_newer) {
+        return true;
+    }
+    if (!mirror_copy(queue, false)) {
+        return false;
+    }
+    m_memory->invalidate(0, m_size);
+    m_mirror_state = mirror_state::in_sync;
+    return true;
+}
+
+void cvk_buffer::mark_mirror_host_written() {
+    std::lock_guard<std::mutex> lock(m_mirror_lock);
+    m_mirror_state = mirror_state::host_newer;
+}
+
+void cvk_buffer::mark_mirror_device_written() {
+    std::lock_guard<std::mutex> lock(m_mirror_lock);
+    m_mirror_state = mirror_state::device_newer;
+}
