+#ifdef _WIN32
+        if ((heap_flags & D3D12_HEAP_FLAG_SHARED) && export_info.handleTypes == VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_WIN32_KMT_BIT)
+        {
+            VkMemoryGetWin32HandleInfoKHR win32_handle_info;
+
+            win32_handle_info.sType = VK_STRUCTURE_TYPE_MEMORY_GET_WIN32_HANDLE_INFO_KHR;
+            win32_handle_info.pNext = NULL;
+            win32_handle_info.memory = allocation->device_allocation.vk_memory;
+            win32_handle_info.handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_WIN32_KMT_BIT;
+            if ((vr = VK_CALL(vkGetMemoryWin32HandleKHR(device->vk_device, &win32_handle_info, &object->vgpu_kmt))))
+            {
+                ERR("Failed to get exported image memory KMT handle, vr %d.\n", vr);
+                object->vgpu_kmt = NULL;
+            }
+        }
+#endif
 
         bind_info.sType = VK_STRUCTURE_TYPE_BIND_IMAGE_MEMORY_INFO;
         bind_info.pNext = NULL;
@@ -11451,3 +11466,14 @@ void vkd3d_global_descriptor_buffer_cleanup(struct vkd3d_global_descriptor_buffe
     vkd3d_free_device_memory(device, &global_descriptor_buffer->resource.device_allocation);
     vkd3d_free_device_memory(device, &global_descriptor_buffer->sampler.device_allocation);
 }
+
+#ifdef _WIN32
+/* vgpu: the KMT handle of a shared committed resource's memory, for the WDDM
+ * driver that hosts this library to share it with other devices (DWM).
+ * Exported from d3d12core; NULL when the resource is not shared. */
+HANDLE WINAPI vkd3d_vgpu_resource_kmt(ID3D12Resource *iface)
+{
+    struct d3d12_resource *resource = impl_from_ID3D12Resource(iface);
+    return resource ? resource->vgpu_kmt : NULL;
+}
+#endif
diff --git a/libs/vkd3d/utils.c b/libs/vkd3d/utils.c
index c62fb31..3b37deb 100644
--- a/libs/vkd3d/utils.c
+++ b/libs/vkd3d/utils.c
@@ -1476,7 +1476,19 @@ HRESULT hresult_from_vk_result(VkResult vr)
             /* NV driver sometimes returns this on invalid API usage. */
             return E_INVALIDARG;
         default:
+#ifdef _WIN32
+        {
+            /* vgpu: name the call site (module-relative) so the failing Vulkan call can be found. */
+            HMODULE module = NULL;
+            void *caller = __builtin_return_address(0);
+            GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                    (LPCSTR)caller, &module);
+            FIXME("Unhandled VkResult %d, caller %p (module %p, +0x%"PRIxPTR").\n", vr, caller, (void *)module,
+                    (uintptr_t)caller - (uintptr_t)module);
+        }
+#else
             FIXME("Unhandled VkResult %d.\n", vr);
+#endif
             /* fall-through */
         case VK_ERROR_DEVICE_LOST:
         case VK_ERROR_EXTENSION_NOT_PRESENT:
