diff --git a/src/virtio/vulkan/vn_renderer_vgpu.c b/src/virtio/vulkan/vn_renderer_vgpu.c
new file mode 100644
index 0000000..1bb0589
--- /dev/null
+++ b/src/virtio/vulkan/vn_renderer_vgpu.c
@@ -0,0 +1,855 @@
+/*
+ * Copyright 2026 vgpu authors
+ * SPDX-License-Identifier: MIT
+ *
+ * Venus renderer backend for Windows guests, on top of the vgpu kernel driver's
+ * \\.\VGpu3D control device (see vgpu_abi.h).  The ioctl set mirrors Linux DRM
+ * virtgpu, so this follows vn_renderer_virtgpu.c closely.  The differences:
+ *
+ *  - no dma-buf / sync file interop (has_dma_buf_import = has_external_sync = false),
+ *    like the vtest backend;
+ *  - no kernel timeline syncobjs: vn_renderer_sync timelines are emulated here on top
+ *    of the per-ring fence ids returned by EXECBUFFER (similar in spirit to
+ *    vn_renderer_sim_syncobj.c);
+ *  - mappings are placed by the kernel, so placed maps are not supported.
+ */
+
+#include <windows.h>
+#include <winioctl.h>
+#include <xmmintrin.h>
+
+#include "virtio/virtio-gpu/venus_hw.h"
+
+#include "util/os_time.h"
+
+#include "vgpu_abi.h"
+#include "vn_renderer_internal.h"
+
+#define VGPU_PCI_VENDOR_ID 0x1af4
+#define VGPU_PCI_DEVICE_ID 0x1050
+
+struct vgpu_shmem {
+   struct vn_renderer_shmem base;
+   uint32_t handle;
+};
+
+struct vgpu_bo {
+   struct vn_renderer_bo base;
+   uint32_t handle;
+   uint32_t blob_flags;
+};
+
+/* a not-yet-observed signal: the sync reaches `value` once fence `fence_id`
+ * on ring `ring_idx` completes
+ */
+struct vgpu_sync_point {
+   uint32_t ring_idx;
+   uint64_t fence_id;
+   uint64_t value;
+};
+
+struct vgpu_sync {
+   struct vn_renderer_sync base;
+
+   /* protected by vgpu::sync_mutex */
+   uint64_t value;
+   struct vgpu_sync_point *points;
+   uint32_t point_count;
+   uint32_t point_capacity;
+};
+
+struct vgpu {
+   struct vn_renderer base;
+
+   struct vn_instance *instance;
+
+   HANDLE dev;
+
+   uint32_t max_timeline_count;
+   uint32_t blob_alignment;
+
+   struct {
+      uint32_t id;
+      uint32_t version;
+      struct virgl_renderer_capset_venus data;
+   } capset;
+
+   mtx_t sync_mutex;
+
+   struct vn_renderer_shmem_cache shmem_cache;
+};
+
+static bool
+vgpu_ioctl(struct vgpu *gpu, DWORD code, void *buf, size_t size)
+{
+   DWORD ret = 0;
+   if (!DeviceIoControl(gpu->dev, code, buf, (DWORD)size, buf, (DWORD)size,
+                        &ret, NULL)) {
+      if (VN_DEBUG(INIT)) {
+         vn_log(gpu->instance, "vgpu ioctl 0x%lx failed: %lu",
+                (unsigned long)code, (unsigned long)GetLastError());
+      }
+      return false;
+   }
+   return true;
+}
+
+static uint64_t
+vgpu_getparam(struct vgpu *gpu, uint64_t param)
+{
+   VGPU_GETPARAM args = { .param = param };
+   return vgpu_ioctl(gpu, IOCTL_VGPU_GETPARAM, &args, sizeof(args))
+             ? args.value
+             : 0;
+}
+
+static uint32_t
+vgpu_create_blob(struct vgpu *gpu,
+                 const struct vn_renderer_submit_batch *batch,
+                 uint32_t blob_mem,
+                 uint32_t blob_flags,
+                 size_t size,
+                 uint64_t blob_id)
+{
+   const size_t cmd_size = batch ? batch->cs_size : 0;
+   const size_t total = sizeof(VGPU_RESOURCE_CREATE_BLOB) + cmd_size;
+   VGPU_RESOURCE_CREATE_BLOB *args = calloc(1, total);
+   if (!args)
+      return 0;
+
+   args->blob_mem = blob_mem;
+   args->blob_flags = blob_flags;
+   args->blob_id = blob_id;
+   args->size = align64(size, gpu->blob_alignment);
+   args->cmd_size = (uint32_t)cmd_size;
+   if (cmd_size)
+      memcpy(args + 1, batch->cs_data, cmd_size);
+
+   uint32_t handle = 0;
+   if (vgpu_ioctl(gpu, IOCTL_VGPU_RESOURCE_CREATE_BLOB, args, total)) {
+      handle = args->handle;
+   } else {
+      vn_log(gpu->instance,
+             "RESOURCE_CREATE_BLOB failed: type=%u, flags=%u, size=%zu, "
+             "id=%" PRIu64 ", err=%lu",
+             blob_mem, blob_flags, size, blob_id,
+             (unsigned long)GetLastError());
+   }
+
+   free(args);
+   return handle;
+}
+
+static void *
+vgpu_map(struct vgpu *gpu, uint32_t handle)
+{
+   VGPU_MAP args = { .handle = handle };
+   if (!vgpu_ioctl(gpu, IOCTL_VGPU_MAP, &args, sizeof(args))) {
+      vn_log(gpu->instance, "MAP failed: handle=%u, err=%lu", handle,
+             (unsigned long)GetLastError());
+      return NULL;
+   }
+   return (void *)(uintptr_t)args.user_va;
+}
+
+static void
+vgpu_close(struct vgpu *gpu, uint32_t handle, bool mapped)
+{
+   VGPU_HANDLE args = { .handle = handle };
+   if (mapped)
+      vgpu_ioctl(gpu, IOCTL_VGPU_UNMAP, &args, sizeof(args));
+   vgpu_ioctl(gpu, IOCTL_VGPU_RESOURCE_CLOSE, &args, sizeof(args));
+}
+
+/* ---- syncs ---------------------------------------------------------------- */
+
+static uint64_t
+vgpu_ring_completed(struct vgpu *gpu, uint32_t ring_idx)
+{
+   VGPU_QUERY_FENCE q = { .ring_idx = ring_idx };
+   return vgpu_ioctl(gpu, IOCTL_VGPU_QUERY_FENCE, &q, sizeof(q)) ? q.completed
+                                                                 : 0;
+}
+
+/* fold completed points into sync->value; call with sync_mutex held */
+static void
+vgpu_sync_update_locked(struct vgpu *gpu, struct vgpu_sync *sync)
+{
+   uint64_t completed[VGPU_MAX_RINGS];
+   uint64_t queried = 0; /* bitmask of rings already queried */
+
+   uint32_t kept = 0;
+   for (uint32_t i = 0; i < sync->point_count; i++) {
+      const struct vgpu_sync_point *pt = &sync->points[i];
+      const uint32_t r = pt->ring_idx;
+      if (!(queried & BITFIELD64_BIT(r))) {
+         completed[r] = vgpu_ring_completed(gpu, r);
+         queried |= BITFIELD64_BIT(r);
+      }
+      if (completed[r] >= pt->fence_id) {
+         sync->value = MAX2(sync->value, pt->value);
+      } else {
+         sync->points[kept++] = *pt;
+      }
+   }
+   sync->point_count = kept;
+}
+
+static bool
+vgpu_sync_add_point_locked(struct vgpu_sync *sync,
+                           uint32_t ring_idx,
+                           uint64_t fence_id,
+                           uint64_t value)
+{
+   if (sync->point_count == sync->point_capacity) {
+      const uint32_t cap = MAX2(sync->point_capacity * 2, 4);
+      struct vgpu_sync_point *pts =
+         realloc(sync->points, cap * sizeof(*sync->points));
+      if (!pts)
+         return false;
+      sync->points = pts;
+      sync->point_capacity = cap;
+   }
+   sync->points[sync->point_count++] = (struct vgpu_sync_point){
+      .ring_idx = ring_idx,
+      .fence_id = fence_id,
+      .value = value,
+   };
+   return true;
+}
+
+static VkResult
+vgpu_sync_write(struct vn_renderer *renderer,
+                struct vn_renderer_sync *_sync,
+                uint64_t val)
+{
+   struct vgpu *gpu = (struct vgpu *)renderer;
+   struct vgpu_sync *sync = (struct vgpu_sync *)_sync;
+
+   mtx_lock(&gpu->sync_mutex);
+   sync->value = MAX2(sync->value, val);
+   mtx_unlock(&gpu->sync_mutex);
+
+   return VK_SUCCESS;
+}
+
+static VkResult
+vgpu_sync_read(struct vn_renderer *renderer,
+               struct vn_renderer_sync *_sync,
+               uint64_t *val)
+{
+   struct vgpu *gpu = (struct vgpu *)renderer;
+   struct vgpu_sync *sync = (struct vgpu_sync *)_sync;
+
+   mtx_lock(&gpu->sync_mutex);
+   vgpu_sync_update_locked(gpu, sync);
+   *val = sync->value;
+   mtx_unlock(&gpu->sync_mutex);
+
+   return VK_SUCCESS;
+}
+
+static VkResult
+vgpu_sync_reset(struct vn_renderer *renderer, struct vn_renderer_sync *_sync)
+{
+   struct vgpu *gpu = (struct vgpu *)renderer;
+   struct vgpu_sync *sync = (struct vgpu_sync *)_sync;
+
+   mtx_lock(&gpu->sync_mutex);
+   sync->value = 0;
+   sync->point_count = 0;
+   mtx_unlock(&gpu->sync_mutex);
+
+   return VK_SUCCESS;
+}
+
+static void
+vgpu_sync_destroy(struct vn_renderer *renderer, struct vn_renderer_sync *_sync)
+{
+   struct vgpu_sync *sync = (struct vgpu_sync *)_sync;
+
+   free(sync->points);
+   free(sync);
+}
+
+static VkResult
+vgpu_sync_create(struct vn_renderer *renderer,
+                 uint64_t initial_val,
+                 struct vn_renderer_sync **out_sync)
+{
+   struct vgpu_sync *sync = calloc(1, sizeof(*sync));
+   if (!sync)
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+
+   sync->value = initial_val;
+   *out_sync = &sync->base;
+
+   return VK_SUCCESS;
+}
