+#include <errno.h>
 #include <processthreadsapi.h>
+
+/* Windows has no sync files; the vgpu renderer reports has_external_sync=false,
+ * so the only fd that can reach these helpers is -1 ("already signaled").
+ */
+static inline int
+sync_wait(int fd, int timeout)
+{
+   (void)timeout;
+   if (fd < 0)
+      return 0;
+   errno = EINVAL;
+   return -1;
+}
+
+static inline bool
+sync_valid_fd(int fd)
+{
+   (void)fd;
+   return false;
+}
 #else
 #include <sys/syscall.h>
 
