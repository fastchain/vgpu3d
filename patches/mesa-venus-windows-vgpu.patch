+/* ---- bos ------------------------------------------------------------------ */
+
+static void
+vgpu_bo_invalidate(struct vn_renderer *renderer,
+                   struct vn_renderer_bo *bo,
+                   VkDeviceSize offset,
+                   VkDeviceSize size)
+{
+   /* nop: the host visible window is mapped coherent */
+}
+
+static void
+vgpu_bo_flush(struct vn_renderer *renderer,
+              struct vn_renderer_bo *bo,
+              VkDeviceSize offset,
+              VkDeviceSize size)
+{
+   /* the window may be write-combined: drain WC buffers */
+   _mm_sfence();
+}
+
+static void *
+vgpu_bo_map(struct vn_renderer *renderer,
+            struct vn_renderer_bo *_bo,
+            void *placed_addr)
+{
+   struct vgpu *gpu = (struct vgpu *)renderer;
+   struct vgpu_bo *bo = (struct vgpu_bo *)_bo;
+   const bool mappable = bo->blob_flags & VGPU_BLOB_FLAG_USE_MAPPABLE;
+
+   /* the kernel picks the address; VK_EXT_map_memory_placed is not exposed */
+   if (placed_addr)
+      return NULL;
+
+   /* not thread-safe but is fine */
+   if (!bo->base.mmap_ptr && mappable)
+      bo->base.mmap_ptr = vgpu_map(gpu, bo->handle);
+
+   return bo->base.mmap_ptr;
+}
+
+static int
+vgpu_bo_export_dma_buf(struct vn_renderer *renderer,
+                       struct vn_renderer_bo *bo)
+{
+   return -1;
+}
+
+static int
+vgpu_bo_export_sync_file(struct vn_renderer *renderer,
+                         struct vn_renderer_bo *bo)
+{
+   return -1;
+}
+
+static bool
+vgpu_bo_destroy(struct vn_renderer *renderer, struct vn_renderer_bo *_bo)
+{
+   struct vgpu *gpu = (struct vgpu *)renderer;
+   struct vgpu_bo *bo = (struct vgpu_bo *)_bo;
+
+   /* no imports, so nothing can revive the refcount */
+   vgpu_close(gpu, bo->handle, bo->base.mmap_ptr != NULL);
+   free(bo);
+
+   return true;
+}
+
+static VkResult
+vgpu_bo_create_from_device_memory(
+   struct vn_renderer *renderer,
+   struct vn_renderer_submit_batch *batch,
+   VkDeviceSize size,
+   vn_object_id mem_id,
+   VkMemoryPropertyFlags flags,
+   VkExternalMemoryHandleTypeFlags external_handles,
+   struct vn_renderer_bo **out_bo)
+{
+   struct vgpu *gpu = (struct vgpu *)renderer;
+
+   uint32_t blob_flags = 0;
+   if (flags & VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT)
+      blob_flags |= VGPU_BLOB_FLAG_USE_MAPPABLE;
+   if (external_handles)
+      blob_flags |= VGPU_BLOB_FLAG_USE_SHAREABLE;
+
+   struct vgpu_bo *bo = calloc(1, sizeof(*bo));
+   if (!bo)
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+
+   const uint32_t handle = vgpu_create_blob(gpu, batch, VGPU_BLOB_MEM_HOST3D,
+                                            blob_flags, size, mem_id);
+   if (!handle) {
+      free(bo);
+      return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+   }
+
+   *bo = (struct vgpu_bo){
+      .base = {
+         .refcount = VN_REFCOUNT_INIT(1),
+         .res_id = handle,
+         .mmap_size = size,
+      },
+      .handle = handle,
+      .blob_flags = blob_flags,
+   };
+
+   *out_bo = &bo->base;
+
+   return VK_SUCCESS;
+}
+
+/* ---- shmem ---------------------------------------------------------------- */
+
+static void
+vgpu_shmem_destroy_now(struct vn_renderer *renderer,
+                       struct vn_renderer_shmem *_shmem)
+{
+   struct vgpu *gpu = (struct vgpu *)renderer;
+   struct vgpu_shmem *shmem = (struct vgpu_shmem *)_shmem;
+
+   vgpu_close(gpu, shmem->handle, true);
+   free(shmem);
+}
+
+static void
+vgpu_shmem_destroy(struct vn_renderer *renderer,
+                   struct vn_renderer_shmem *shmem)
+{
+   struct vgpu *gpu = (struct vgpu *)renderer;
+
+   if (vn_renderer_shmem_cache_add(&gpu->shmem_cache, shmem))
+      return;
+
+   vgpu_shmem_destroy_now(&gpu->base, shmem);
+}
+
+static struct vn_renderer_shmem *
+vgpu_shmem_create(struct vn_renderer *renderer, size_t size)
+{
+   struct vgpu *gpu = (struct vgpu *)renderer;
+
+   struct vn_renderer_shmem *cached_shmem =
+      vn_renderer_shmem_cache_get(&gpu->shmem_cache, size);
+   if (cached_shmem) {
+      cached_shmem->refcount = VN_REFCOUNT_INIT(1);
+      return cached_shmem;
+   }
+
+   struct vgpu_shmem *shmem = calloc(1, sizeof(*shmem));
+   if (!shmem)
+      return NULL;
+
+   /* HOST3D + MAPPABLE + blob_id 0 makes the render server allocate host
+    * shmem (supports_blob_id_0), see virtgpu_init_shmem_blob_mem
+    */
+   const uint32_t handle = vgpu_create_blob(
+      gpu, NULL, VGPU_BLOB_MEM_HOST3D, VGPU_BLOB_FLAG_USE_MAPPABLE, size, 0);
+   if (!handle) {
+      free(shmem);
+      return NULL;
+   }
+
+   void *ptr = vgpu_map(gpu, handle);
+   if (!ptr) {
+      vgpu_close(gpu, handle, false);
+      free(shmem);
+      return NULL;
+   }
+
+   *shmem = (struct vgpu_shmem){
+      .base = {
+         .refcount = VN_REFCOUNT_INIT(1),
+         .res_id = handle,
+         .mmap_size = size,
+         .mmap_ptr = ptr,
+      },
+      .handle = handle,
+   };
+
+   return &shmem->base;
+}
+
+/* ---- submit / wait -------------------------------------------------------- */
+
+static VkResult
+vgpu_wait(struct vn_renderer *renderer, const struct vn_renderer_wait *wait)
+{
+   struct vgpu *gpu = (struct vgpu *)renderer;
+   const uint64_t abs_timeout = os_time_get_absolute_timeout(wait->timeout);
+
+   while (true) {
+      /* find one fence that would make progress on an unsatisfied sync */
+      bool done = !wait->wait_any;
+      bool have_fence = false;
+      VGPU_WAIT_FENCE wf = { 0 };
+
+      mtx_lock(&gpu->sync_mutex);
+      for (uint32_t i = 0; i < wait->sync_count; i++) {
+         struct vgpu_sync *sync = (struct vgpu_sync *)wait->syncs[i];
+         const uint64_t target = wait->sync_values[i];
+
+         vgpu_sync_update_locked(gpu, sync);
+         if (sync->value >= target) {
+            if (wait->wait_any) {
+               done = true;
+               break;
+            }
+            continue;
+         }
+
+         if (!wait->wait_any)
+            done = false;
+
+         for (uint32_t j = 0; j < sync->point_count && !have_fence; j++) {
+            if (sync->points[j].value >= target) {
+               wf.ring_idx = sync->points[j].ring_idx;
+               wf.fence_id = sync->points[j].fence_id;
+               have_fence = true;
+            }
+         }
+      }
+      mtx_unlock(&gpu->sync_mutex);
+
+      if (done)
+         return VK_SUCCESS;
+
+      const uint64_t now = os_time_get_nano();
+      if (now >= abs_timeout)
+         return VK_TIMEOUT;
+
+      /* Block on the kernel fence in short slices so that CPU-side writes
+       * (vkSignalSemaphore) and the other syncs of a wait-any are rechecked.
+       * Without a pending fence the target can only be reached by a CPU
+       * write, so just yield.
+       */
+      const uint64_t left_ms = (abs_timeout - now) / 1000000;
+      if (have_fence) {
+         wf.timeout_ms = (uint32_t)MIN2(MAX2(left_ms, 1), 20);
+         if (!vgpu_ioctl(gpu, IOCTL_VGPU_WAIT_FENCE, &wf, sizeof(wf)))
+            return VK_ERROR_DEVICE_LOST;
+      } else {
+         Sleep(left_ms ? 1 : 0);
+      }
+   }
+}
+
+static VkResult
+vgpu_submit(struct vn_renderer *renderer,
+            const struct vn_renderer_submit_batch *batch)
+{
+   struct vgpu *gpu = (struct vgpu *)renderer;
+
+   const size_t total = VGPU_EXECBUF_TOTAL(0, batch->cs_size);
+   VGPU_EXECBUFFER *args = malloc(total);
+   if (!args)
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+
+   *args = (VGPU_EXECBUFFER){
+      .flags = VGPU_EXECBUF_RING_IDX | (batch->sync_count ? VGPU_EXECBUF_FENCE : 0),
+      .size = (uint32_t)batch->cs_size,
+      .ring_idx = batch->ring_idx,
+   };
+   if (batch->cs_size)
+      memcpy(VGPU_EXECBUF_CMD(args), batch->cs_data, batch->cs_size);
+
+   /* The host visible window can be mapped write-combined (e.g. resizable-BAR
+    * VRAM on the host).  Drain WC buffers so the device never sees stores that
+    * land after it has already written the memory.
+    */
+   _mm_sfence();
+
+   /* A fence that completes before its point is recorded is still folded in by
+    * the next update, so the lock is not needed across the ioctl.
+    */
+   const bool ok = vgpu_ioctl(gpu, IOCTL_VGPU_EXECBUFFER, args, total);
+   mtx_lock(&gpu->sync_mutex);
+   if (ok) {
+      for (uint32_t i = 0; i < batch->sync_count; i++) {
+         struct vgpu_sync *sync = (struct vgpu_sync *)batch->syncs[i];
+         vgpu_sync_update_locked(gpu, sync);
+         if (!vgpu_sync_add_point_locked(sync, batch->ring_idx, args->fence_id,
+                                         batch->sync_values[i])) {
+            mtx_unlock(&gpu->sync_mutex);
+            free(args);
+            return VK_ERROR_OUT_OF_HOST_MEMORY;
+         }
+      }
+   }
+   mtx_unlock(&gpu->sync_mutex);
+
+   free(args);
+   return ok ? VK_SUCCESS : VK_ERROR_DEVICE_LOST;
+}
+
+/* ---- init ----------------------------------------------------------------- */
+
+static void
+vgpu_init_renderer_info(struct vgpu *gpu)
+{
+   struct vn_renderer_info *info = &gpu->base.info;
+
+   info->pci.vendor_id = VGPU_PCI_VENDOR_ID;
+   info->pci.device_id = VGPU_PCI_DEVICE_ID;
+
+   info->has_dma_buf_import = false;
+   info->has_external_sync = false;
+   info->has_timeline_sync = !VN_PERF(NO_TIMELINE_SYNC);
+   info->has_implicit_fencing = false;
+
+   const struct virgl_renderer_capset_venus *capset = &gpu->capset.data;
+   info->wire_format_version = capset->wire_format_version;
+   info->vk_xml_version = capset->vk_xml_version;
+   info->vk_ext_command_serialization_spec_version =
+      capset->vk_ext_command_serialization_spec_version;
+   info->vk_mesa_venus_protocol_spec_version =
+      capset->vk_mesa_venus_protocol_spec_version;
+   assert(capset->supports_blob_id_0);
+
+   /* ensure vk_extension_mask is large enough to hold all capset masks */
+   STATIC_ASSERT(sizeof(info->vk_extension_mask) >=
+                 sizeof(capset->vk_extension_mask1));
+   memcpy(info->vk_extension_mask, capset->vk_extension_mask1,
+          sizeof(capset->vk_extension_mask1));
+
+   assert(capset->allow_vk_wait_syncs);
+
+   assert(capset->supports_multiple_timelines);
+   info->max_timeline_count = gpu->max_timeline_count;
+
+   /* KVM ignores the guest PAT for host RAM by default, so the guest maps
+    * everything write-back while the host GPU writes uncached/WC system memory
+    * without snooping: only HOST_CACHED types stay coherent.  Set
+    * VN_VGPU_ALLOW_UNCACHED=1 when the host honors the guest PAT.
+    */
+   const char *allow_uncached = getenv("VN_VGPU_ALLOW_UNCACHED");
+   info->needs_cached_host_visible =
+      !(allow_uncached && allow_uncached[0] == '1');
+
+   /* the win32 WSI blits on the present queue (CPU present path) */
+   info->no_async_present = true;
+
+   /* Use guest blob allocations from dedicated heap (Host visible memory) */
+   if (capset->use_guest_vram)
+      info->has_guest_vram = true;
+}
+
+static void
+vgpu_destroy(struct vn_renderer *renderer, const VkAllocationCallbacks *alloc)
+{
+   struct vgpu *gpu = (struct vgpu *)renderer;
+
+   vn_renderer_shmem_cache_fini(&gpu->shmem_cache);
+
+   /* closing the handle tears down the context and every resource it owns */
+   if (gpu->dev != INVALID_HANDLE_VALUE)
+      CloseHandle(gpu->dev);
+
+   mtx_destroy(&gpu->sync_mutex);
+
+   vk_free(alloc, gpu);
+}
+
+static VkResult
+vgpu_init_params(struct vgpu *gpu)
+{
+   if (vgpu_getparam(gpu, VGPU_PARAM_ABI_VERSION) != VGPU_ABI_VERSION) {
+      if (VN_DEBUG(INIT))
+         vn_log(gpu->instance, "vgpu ABI version mismatch");
+      return VK_ERROR_INITIALIZATION_FAILED;
+   }
+
+   const uint64_t required_params[] = {
+      VGPU_PARAM_3D_FEATURES,
+      VGPU_PARAM_CAPSET_QUERY_FIX,
+      VGPU_PARAM_RESOURCE_BLOB,
+      VGPU_PARAM_CONTEXT_INIT,
+      VGPU_PARAM_HOST_VISIBLE,
+   };
+   for (uint32_t i = 0; i < ARRAY_SIZE(required_params); i++) {
+      if (!vgpu_getparam(gpu, required_params[i])) {
+         if (VN_DEBUG(INIT)) {
+            vn_log(gpu->instance, "required vgpu param %d is missing",
+                   (int)required_params[i]);
+         }
+         return VK_ERROR_INITIALIZATION_FAILED;
+      }
+   }
+
+   if (!(vgpu_getparam(gpu, VGPU_PARAM_SUPPORTED_CAPSET_IDS) &
+         BITFIELD64_BIT(VGPU_CAPSET_VENUS))) {
+      if (VN_DEBUG(INIT))
+         vn_log(gpu->instance, "host does not offer the venus capset");
+      return VK_ERROR_INITIALIZATION_FAILED;
+   }
+
+   /* the kernel hands out host visible space in pages */
+   gpu->blob_alignment = 4096;
+   gpu->max_timeline_count = VGPU_MAX_RINGS;
+
+   return VK_SUCCESS;
+}
+
+static VkResult
+vgpu_init_capset(struct vgpu *gpu)
+{
+   gpu->capset.id = VGPU_CAPSET_VENUS;
+   gpu->capset.version = 0;
+
+   struct {
+      VGPU_GET_CAPS hdr;
+      struct virgl_renderer_capset_venus data;
+   } args = {
+      .hdr = {
+         .cap_set_id = gpu->capset.id,
+         .cap_set_ver = gpu->capset.version,
+         .size = sizeof(args.data),
+      },
+   };
+   if (!vgpu_ioctl(gpu, IOCTL_VGPU_GET_CAPS, &args, sizeof(args))) {
+      if (VN_DEBUG(INIT)) {
+         vn_log(gpu->instance, "failed to get venus v%d capset",
+                gpu->capset.version);
+      }
+      return VK_ERROR_INITIALIZATION_FAILED;
+   }
+   gpu->capset.data = args.data;
+
+   if (gpu->capset.data.wire_format_version == 0) {
+      if (VN_DEBUG(INIT)) {
+         vn_log(gpu->instance, "Unsupported wire format version %u",
+                gpu->capset.data.wire_format_version);
+      }
+      return VK_ERROR_INITIALIZATION_FAILED;
+   }
+
+   return VK_SUCCESS;
+}
+
+static VkResult
+vgpu_init_context(struct vgpu *gpu)
+{
+   VGPU_CONTEXT_INIT args = {
+      .capset_id = gpu->capset.id,
+      .num_rings = gpu->max_timeline_count,
+      .poll_rings_mask = 0, /* fences are polled through the kernel */
+   };
+   snprintf(args.debug_name, sizeof(args.debug_name), "venus");
+
+   if (!vgpu_ioctl(gpu, IOCTL_VGPU_CONTEXT_INIT, &args, sizeof(args))) {
+      if (VN_DEBUG(INIT))
+         vn_log(gpu->instance, "failed to initialize context");
+      return VK_ERROR_INITIALIZATION_FAILED;
+   }
+
+   return VK_SUCCESS;
+}
+
+static VkResult
+vgpu_init(struct vgpu *gpu)
+{
+   mtx_init(&gpu->sync_mutex, mtx_plain);
+
+   gpu->dev = CreateFileW(VGPU_DEVICE_USER_PATH, GENERIC_READ | GENERIC_WRITE,
+                          0, NULL, OPEN_EXISTING, 0, NULL);
+   if (gpu->dev == INVALID_HANDLE_VALUE) {
+      if (VN_DEBUG(INIT)) {
+         vn_log(gpu->instance, "failed to open \\\\.\\VGpu3D: %lu",
+                (unsigned long)GetLastError());
+      }
+      return VK_ERROR_INITIALIZATION_FAILED;
+   }
+
+   VkResult result = vgpu_init_params(gpu);
+   if (result == VK_SUCCESS)
+      result = vgpu_init_capset(gpu);
+   if (result == VK_SUCCESS)
+      result = vgpu_init_context(gpu);
+   if (result != VK_SUCCESS)
+      return result;
+
+   vn_renderer_shmem_cache_init(&gpu->shmem_cache, &gpu->base,
+                                vgpu_shmem_destroy_now);
+
+   vgpu_init_renderer_info(gpu);
+
+   gpu->base.ops.destroy = vgpu_destroy;
+   gpu->base.ops.submit = vgpu_submit;
+   gpu->base.ops.wait = vgpu_wait;
+
+   gpu->base.shmem_ops.create = vgpu_shmem_create;
+   gpu->base.shmem_ops.destroy = vgpu_shmem_destroy;
+
+   gpu->base.bo_ops.create_from_device_memory =
+      vgpu_bo_create_from_device_memory;
+   gpu->base.bo_ops.create_from_dma_buf = NULL;
+   gpu->base.bo_ops.destroy = vgpu_bo_destroy;
+   gpu->base.bo_ops.export_dma_buf = vgpu_bo_export_dma_buf;
+   gpu->base.bo_ops.export_sync_file = vgpu_bo_export_sync_file;
+   gpu->base.bo_ops.map = vgpu_bo_map;
+   gpu->base.bo_ops.flush = vgpu_bo_flush;
+   gpu->base.bo_ops.invalidate = vgpu_bo_invalidate;
+
+   gpu->base.sync_ops.create = vgpu_sync_create;
+   gpu->base.sync_ops.create_from_syncobj = NULL;
+   gpu->base.sync_ops.destroy = vgpu_sync_destroy;
+   gpu->base.sync_ops.export_syncobj = NULL;
+   gpu->base.sync_ops.reset = vgpu_sync_reset;
+   gpu->base.sync_ops.read = vgpu_sync_read;
+   gpu->base.sync_ops.write = vgpu_sync_write;
+
+   return VK_SUCCESS;
+}
+
+VkResult
+vn_renderer_create_vgpu(struct vn_instance *instance,
+                        const VkAllocationCallbacks *alloc,
+                        struct vn_renderer **renderer)
+{
+   struct vgpu *gpu = vk_zalloc(alloc, sizeof(*gpu), VN_DEFAULT_ALIGN,
+                                VK_SYSTEM_ALLOCATION_SCOPE_INSTANCE);
+   if (!gpu)
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+
+   gpu->instance = instance;
+   gpu->dev = INVALID_HANDLE_VALUE;
+
+   VkResult result = vgpu_init(gpu);
+   if (result != VK_SUCCESS) {
+      vgpu_destroy(&gpu->base, alloc);
+      return result;
+   }
+
+   *renderer = &gpu->base;
+
+   if (VN_DEBUG(INIT))
+      vn_log(gpu->instance, "vgpu backend initialized");
+
+   return VK_SUCCESS;
+}
