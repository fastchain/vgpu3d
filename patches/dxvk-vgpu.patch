+    static uint32_t s_checked = 0, s_bad = 0;
+    if (likely(!s_verify) || !pInitialData || desc.SampleDesc.Count > 1
+     || (desc.Usage != D3D11_USAGE_DEFAULT && desc.Usage != D3D11_USAGE_IMMUTABLE))
+      return;
+
+    Com<ID3D11Resource> staging;
+    if (dim == D3D11_RESOURCE_DIMENSION_TEXTURE2D) {
+      D3D11_TEXTURE2D_DESC sd = { desc.Width, desc.Height, desc.MipLevels, desc.ArraySize, desc.Format,
+        { 1, 0 }, D3D11_USAGE_STAGING, 0, D3D11_CPU_ACCESS_READ, 0 };
+      Com<ID3D11Texture2D> t;
+      if (FAILED(pDevice->CreateTexture2D(&sd, nullptr, &t)))
+        return;
+      staging = t.ptr();
+    } else {
+      D3D11_TEXTURE3D_DESC sd = { desc.Width, desc.Height, desc.Depth, desc.MipLevels, desc.Format,
+        D3D11_USAGE_STAGING, 0, D3D11_CPU_ACCESS_READ, 0 };
+      Com<ID3D11Texture3D> t;
+      if (FAILED(pDevice->CreateTexture3D(&sd, nullptr, &t)))
+        return;
+      staging = t.ptr();
+    }
+
+    Com<ID3D11DeviceContext> ctx;
+    pDevice->GetImmediateContext(&ctx);
+    ctx->CopyResource(staging.ptr(), pTexture);
+
+    auto fmt = lookupFormatInfo(pDevice->LookupPackedFormat(desc.Format, mode).Format);
+    uint32_t bad = 0;
+    for (uint32_t a = 0; a < desc.ArraySize; a++) {
+      for (uint32_t m = 0; m < desc.MipLevels; m++) {
+        uint32_t sub = m + a * desc.MipLevels;
+        const D3D11_SUBRESOURCE_DATA& src = pInitialData[sub];
+        uint32_t w = std::max(desc.Width >> m, 1u), h = std::max(desc.Height >> m, 1u), d = std::max(desc.Depth >> m, 1u);
+        uint32_t rows = (h + fmt->blockSize.height - 1) / fmt->blockSize.height;
+        size_t rowBytes = size_t((w + fmt->blockSize.width - 1) / fmt->blockSize.width) * fmt->elementSize;
+        D3D11_MAPPED_SUBRESOURCE map;
+        if (!src.pSysMem || FAILED(ctx->Map(staging.ptr(), sub, D3D11_MAP_READ, 0, &map)))
+          continue;
+        size_t diff = 0, firstDiff = ~size_t(0);
+        bool srcZero = true, gpuZero = true;
+        for (uint32_t z = 0; z < d; z++) {
+          for (uint32_t y = 0; y < rows; y++) {
+            auto a8 = reinterpret_cast<const uint8_t*>(src.pSysMem) + size_t(z) * src.SysMemSlicePitch + size_t(y) * src.SysMemPitch;
+            auto b8 = reinterpret_cast<const uint8_t*>(map.pData) + size_t(z) * map.DepthPitch + size_t(y) * map.RowPitch;
+            for (size_t x = 0; x < rowBytes; x++) {
+              srcZero &= !a8[x];
+              gpuZero &= !b8[x];
+              if (a8[x] != b8[x]) {
+                if (!diff)
+                  firstDiff = (size_t(z) * rows + y) * rowBytes + x;
+                diff++;
+              }
+            }
+          }
+        }
+        ctx->Unmap(staging.ptr(), sub);
+        if (diff) {
+          bad++;
+          if (s_bad < 200) {
+            char msg[320];
+            snprintf(msg, sizeof(msg), "vgpu-verify MISMATCH %p dim %u %ux%ux%u fmt %u sub %u (mip %u slice %u) bind 0x%x misc 0x%x: %zu bytes differ, first at %zu, app %s gpu %s",
+              pTexture, dim, w, h, d, desc.Format, sub, m, a, desc.BindFlags, desc.MiscFlags, diff, firstDiff,
+              srcZero ? "zero" : "data", gpuZero ? "zero" : "data");
+            Logger::warn(msg);
+          }
+        }
+      }
+    }
+    s_checked++;
+    if (bad)
+      s_bad++;
+    if (bad || (s_checked % 256) == 0) {
+      char msg[128];
+      snprintf(msg, sizeof(msg), "vgpu-verify %u textures checked, %u with mismatches", s_checked, s_bad);
+      Logger::warn(msg);
+    }
+  }
   
