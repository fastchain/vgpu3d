diff --git a/src/d3d11/d3d11_interop.cpp b/src/d3d11/d3d11_interop.cpp
index 04fef383..8d6d9e64 100644
--- a/src/d3d11/d3d11_interop.cpp
+++ b/src/d3d11/d3d11_interop.cpp
@@ -157,4 +157,48 @@ namespace dxvk {
       return E_INVALIDARG;
     }
   }
+
+  HRESULT STDMETHODCALLTYPE D3D11VkInterop::CreateTexture2DFromSharedHandle(
+          const D3D11_TEXTURE2D_DESC1 *pDesc,
+          HANDLE hKmtHandle,
+          ID3D11Texture2D **ppTexture2D) {
+    InitReturnPtr(ppTexture2D);
+
+    if (!pDesc || !hKmtHandle || hKmtHandle == INVALID_HANDLE_VALUE)
+      return E_INVALIDARG;
+
+    D3D11_COMMON_TEXTURE_DESC desc;
+    desc.Width          = pDesc->Width;
+    desc.Height         = pDesc->Height;
+    desc.Depth          = 1;
+    desc.MipLevels      = pDesc->MipLevels;
+    desc.ArraySize      = pDesc->ArraySize;
+    desc.Format         = pDesc->Format;
+    desc.SampleDesc     = pDesc->SampleDesc;
+    desc.Usage          = pDesc->Usage;
+    desc.BindFlags      = pDesc->BindFlags;
+    desc.CPUAccessFlags = pDesc->CPUAccessFlags;
+    desc.MiscFlags      = pDesc->MiscFlags | D3D11_RESOURCE_MISC_SHARED;
+    desc.TextureLayout  = pDesc->TextureLayout;
+
+    HRESULT hr = D3D11CommonTexture::NormalizeTextureProperties(&desc);
+
+    if (FAILED(hr))
+      return hr;
+
+    if (!ppTexture2D)
+      return S_FALSE;
+
+    try {
+      /* Same construction as OpenSharedResource: identical image parameters
+       * to the exporter, memory imported from the KMT handle. */
+      Com<D3D11Texture2D> texture = new D3D11Texture2D(m_device, &desc, nullptr, hKmtHandle);
+      *ppTexture2D = texture.ref();
+      return S_OK;
+    } catch (const DxvkError& e) {
+      Logger::err(e.message());
+      return E_INVALIDARG;
+    }
+  }
+
 }
