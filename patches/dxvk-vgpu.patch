+  // vgpu: VGPU_VERIFY_INIT=1 reads every DEFAULT/IMMUTABLE 2D/3D texture created with initial data back
+  // through a staging copy and logs subresources whose GPU contents differ from the app's data.
+  static void VgpuVerifyInitData(
+          D3D11Device*                  pDevice,
+          ID3D11Resource*               pTexture,
+    const D3D11_COMMON_TEXTURE_DESC&    desc,
+          D3D11_RESOURCE_DIMENSION      dim,
