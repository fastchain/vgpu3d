;
; vgpu3d.inf - WDDM render driver for virtio-gpu: Vulkan, Direct3D 10/11 and OpenGL, 64-bit and WOW64.
; Kernel driver: our build of viogpu3d (osy/kvm-guest-drivers-windows "neptune", BSD-3).
; Based on viogpu3d.inf (Red Hat / osy); Neptune D3D UMD replaced by Triton DDI + DXVK, Zink OpenGL ICD added.
;
[Version]
Signature="$Windows NT$"
Class=Display
ClassGUID={4d36e968-e325-11ce-bfc1-08002be10318}
Provider=%VGPU%
DriverVer=11/05/2026,1.0.0.0
CatalogFile=vgpu3d.cat
PnpLockdown=1

[DestinationDirs]
VioGpu3D_Files.Driver = 13
VioGpu3D_Files.Usermode = 13

[SourceDisksNames]
1 = %DiskId1%,,,""

[SourceDisksFiles]
viogpu3d.sys = 1,,
vulkan_virtio.dll = 1,,
virtio_icd.json = 1,,
libgallium_wgl.dll = 1,,
vgpu_d3d11.dll = 1,,
dxvk_d3d11.dll = 1,,
dxvk_dxgi.dll = 1,,
vgpu_d3d11_32.dll = 1,,
dxvk32_d3d11.dll = 1,,
dxvk32_dxgi.dll = 1,,
vulkan_virtio32.dll = 1,,
virtio_icd32.json = 1,,
libgallium_wgl32.dll = 1,,
vgpusrv.exe = 1,,
viogpuap.exe = 1,,

[Manufacturer]
%VGPU%=VGPU,NTamd64.10.0...16299

[VGPU.NTamd64.10.0...16299]
%VioGpu3D.DeviceDesc% = VioGpu3D_Inst, PCI\VEN_1AF4&DEV_1050&SUBSYS_11001AF4&REV_01, PCI\VEN_1AF4&DEV_1050

[VioGpu3D_Files.Driver]
viogpu3d.sys,,,2

[VioGpu3D_Files.Usermode]
vulkan_virtio.dll,,,0
virtio_icd.json,,,0
libgallium_wgl.dll,,,0
vgpu_d3d11.dll,,,0
dxvk_d3d11.dll,,,0
dxvk_dxgi.dll,,,0
vgpu_d3d11_32.dll,,,0
dxvk32_d3d11.dll,,,0
dxvk32_dxgi.dll,,,0
vulkan_virtio32.dll,,,0
virtio_icd32.json,,,0
libgallium_wgl32.dll,,,0
vgpusrv.exe,,,0
viogpuap.exe,,,0

[VioGpu3D_Inst]
Include=msdv.inf
FeatureScore=F9
CopyFiles=VioGpu3D_Files.Driver, VioGpu3D_Files.Usermode
AddReg=VioGpu3D_DeviceSettings

[VioGpu3D_Inst.Services]
AddService = VioGpu3D,0x00000002,VioGpu3D_Service_Inst, VioGpu3D_EventLog_Inst
AddService = vgpusrv,0x00000800,VioGpu3D_GpuSvc_Inst

[VioGpu3D_Inst.HW]
AddReg = VioGpu3D_PCI_MSIX

[VioGpu3D_Service_Inst]
ServiceType = %SERVICE_KERNEL_DRIVER%
StartType = %SERVICE_DEMAND_START%
ErrorControl = %SERVICE_ERROR_IGNORE%
ServiceBinary = %13%\viogpu3d.sys
AddReg = VioGpu3D_Service_AddReg

[VioGpu3D_Service_AddReg]
; KMD trace level (TRACE_LEVEL_*): 4 = information.  5 (verbose) traces every DPC and floods DbgView.
HKR,"Parameters","DebugLevel",%REG_DWORD%,4

[VioGpu3D_GpuSvc_Inst]
DisplayName = %VioGpuSvc.DisplayName%
ServiceType = %SERVICE_WIN32_OWN_PROCESS%
StartType = %SERVICE_AUTO_START%
ErrorControl = %SERVICE_ERROR_NORMAL%
ServiceBinary = %13%\vgpusrv.exe

[VioGpu3D_EventLog_Inst]
AddReg = VioGpu3D_EventLog_Inst.AddReg

[VioGpu3D_EventLog_Inst.AddReg]
HKR,,EventMessageFile,%REG_EXPAND_SZ%,"%%SystemRoot%%\System32\IoLogMsg.dll"
HKR,,TypesSupported,%REG_DWORD%,7

[VioGpu3D_DeviceSettings]
HKR,, HWCursor,          %REG_DWORD%, 0
HKR,, FlexResolution,    %REG_DWORD%, 1
HKR,, UsePhysicalMemory, %REG_DWORD%, 0
; WDDM render adapters must name a D3D UMD or dxgkrnl refuses to start them (LIVEDUMP 0x193/0x804,
; STATUS_OBJECT_NAME_NOT_FOUND); DWM needs a working D3D11 one on the display adapter.
; vgpu_d3d11.dll = Triton's D3D10/11 DDI layer on DXVK (dxvk_d3d11/dxvk_dxgi) on Venus.  D3D9 slot "<>".
; 32-bit (WOW64) processes: vgpu_d3d11_32.dll on dxvk32_d3d11/dxvk32_dxgi and vulkan_virtio32.dll,
; same DriverStore folder, same 64-bit kernel driver (the UMD<->KMD ABI is pointer-size neutral,
; checked by tests/abi32/check.sh).
HKR,, UserModeDriverName,    %REG_MULTI_SZ%, "<>",%13%\vgpu_d3d11.dll,%13%\vgpu_d3d11.dll,%13%\vgpu_d3d11.dll
HKR,, UserModeDriverNameWow, %REG_MULTI_SZ%, "<>",%13%\vgpu_d3d11_32.dll,%13%\vgpu_d3d11_32.dll,%13%\vgpu_d3d11_32.dll
HKR,, VulkanDriverName,  %REG_SZ%,       %13%\virtio_icd.json
HKR,, VulkanDriverNameWow, %REG_SZ%,     %13%\virtio_icd32.json
HKR,, OpenGLDriverName,  %REG_MULTI_SZ%, %13%\libgallium_wgl.dll
HKR,, OpenGLVersion,     %REG_DWORD%, 1
HKR,, OpenGLFlags,       %REG_DWORD%, 1
HKR,, OpenGLDriverNameWow, %REG_MULTI_SZ%, %13%\libgallium_wgl32.dll
HKR,, OpenGLVersionWow,  %REG_DWORD%, 1
HKR,, OpenGLFlagsWow,    %REG_DWORD%, 1
HKLM,"SYSTEM\CurrentControlSet\Control\GraphicsDrivers\Scheduler",EnablePreemption,%REG_DWORD%,0
HKLM,"SYSTEM\CurrentControlSet\Control\GraphicsDrivers",TdrDebugMode,%REG_DWORD%,1

[VioGpu3D_PCI_MSIX]
HKR, "Interrupt Management",, 0x00000010
HKR, "Interrupt Management\MessageSignaledInterruptProperties",, 0x00000010
HKR, "Interrupt Management\MessageSignaledInterruptProperties", MSISupported, 0x00010001, 0
HKR, "Interrupt Management\MessageSignaledInterruptProperties", MessageNumberLimit, 0x00010001, 4

[Strings]
diskId1 = "vgpu WDDM 3D driver"
VioGpu3D.DeviceDesc = "vgpu VirtIO GPU 3D (WDDM)"
VioGpuSvc.DisplayName = "VioGpu Resolution Service"
VGPU = "vgpu"
SERVICE_DEMAND_START = 0x3
SERVICE_AUTO_START = 0x2
SERVICE_KERNEL_DRIVER = 0x1
SERVICE_WIN32_OWN_PROCESS = 0x10
SERVICE_ERROR_IGNORE = 0x0
SERVICE_ERROR_NORMAL = 0x1
REG_SZ        = 0x00000000
REG_MULTI_SZ  = 0x00010000
REG_EXPAND_SZ = 0x00020000
REG_DWORD     = 0x00010001
