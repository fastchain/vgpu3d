#version 460
#extension GL_EXT_ray_query : require
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform accelerationStructureEXT tlas;
layout(set = 0, binding = 1) buffer Out { uvec2 px[]; };
void main() {
    uvec2 p = gl_GlobalInvocationID.xy;
    vec3 o = vec3(-1.0 + (float(p.x) + 0.5) / 32.0, -1.0 + (float(p.y) + 0.5) / 32.0, 0.0);
    rayQueryEXT q;
    rayQueryInitializeEXT(q, tlas, gl_RayFlagsOpaqueEXT, 0xFF, o, 0.001, vec3(0, 0, 1), 100.0);
    while (rayQueryProceedEXT(q)) {}
    uvec2 r = uvec2(0xFFFFu, 0u);
    if (rayQueryGetIntersectionTypeEXT(q, true) == gl_RayQueryCommittedIntersectionTriangleEXT)
        r = uvec2(rayQueryGetIntersectionInstanceCustomIndexEXT(q, true), floatBitsToUint(rayQueryGetIntersectionTEXT(q, true)));
    px[p.y * 64u + p.x] = r;
}
